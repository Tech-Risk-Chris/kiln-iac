{
  "//": "Generated by Kiln from main.kiln. Do not edit; change the source and rebuild.",
  "output": {
    "autopilot_rule": {
      "value": "${one(google_compute_firewall.autopilot[*].id)}"
    },
    "zone_subnets": {
      "value": "${{for key, r in google_compute_subnetwork.zone : key => r.id}}"
    }
  },
  "provider": {
    "google": {
      "project": "acme-dev",
      "region": "europe-west3"
    }
  },
  "resource": {
    "google_compute_firewall": {
      "autopilot": {
        "allow": {
          "ports": [
            "443",
            "10250"
          ],
          "protocol": "tcp"
        },
        "count": "${(google_container_cluster.main.enable_autopilot ? 1 : 0)}",
        "name": "acme-dev-autopilot",
        "network": "default"
      }
    },
    "google_compute_network": {
      "zone": {
        "auto_create_subnetworks": false,
        "for_each": "${google_container_cluster.main.node_locations}",
        "name": "acme-dev-${each.value}"
      }
    },
    "google_compute_subnetwork": {
      "zone": {
        "for_each": "${google_container_cluster.main.node_locations}",
        "ip_cidr_range": "10.20.0.0/24",
        "name": "acme-dev-${each.value}-nodes",
        "network": "${google_compute_network.zone[each.key].id}",
        "region": "europe-west3"
      }
    },
    "google_container_cluster": {
      "main": {
        "deletion_protection": false,
        "initial_node_count": 1,
        "location": "europe-west3",
        "name": "acme-dev",
        "remove_default_node_pool": true
      }
    }
  },
  "terraform": {
    "required_providers": {
      "google": {
        "source": "hashicorp/google",
        "version": "~> 6.0"
      }
    },
    "required_version": ">= 1.7.0"
  }
}
