;; Move test, step 1: the state this creates is what steps 2 and 3 refactor.
(ns move.test
  (:provider [random :as r :version "~> 3.6"]))

(defcomponent names [{:keys [words]}]
  {:pet (r/pet "pet" {:length words})
   :id  (r/id "id" {:byte_length 4})})

(def a (names "alpha" {:words 2}))

(r/integer "port" {:min 1024 :max 2048})

(output "pet" (:id (:pet a)))
